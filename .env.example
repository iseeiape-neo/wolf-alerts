# Wolf Alerts System — Environment Variables
# Copy this file to .env and fill in your values

# ─── Telegram Bot Tokens ──────────────────────────────────
# Create bots via @BotFather on Telegram
WOLF_ALPHA_TOKEN=your_alpha_bot_token_here       # High-confidence signals (score 90+)
WOLF_NEWPAIRS_TOKEN=your_newpairs_bot_token_here  # New token launches
WOLF_MOMENTUM_TOKEN=your_momentum_bot_token_here  # Breakouts & volume spikes
WOLF_WHALE_TOKEN=your_whale_bot_token_here        # High-volume whale activity
WOLF_MAIN_TOKEN=your_main_bot_token_here          # All signals (score 85+)

# ─── Telegram Chat / Channel ID ───────────────────────────
# Your Telegram user ID or channel ID to receive alerts
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Optional: Cielo Finance Referral ─────────────────────
# Your Cielo referral code for trade links in alerts
CIELO_REF=your_ref_code_here
